import rodados.*
import dependencia.*

describe "Test etapa 1" {
   const deportes = new Dependencia( cantidadDeEmpleados = 45 )
   const cultura = new Dependencia( cantidadDeEmpleados = 31 )


  method initialize(){
    
    const cachito = new ChevyCorsa(color = rojo)
    
    const rodadosParaDeportes = [cachito, //1300
                                 new ChevyCorsa(color = azul), 
                                 new ChevyCorsa(color = verde),
                                 new RenauldKwid(tieneTanque = true),
                                 new AutoEspecial(capacidad = 5, velocidadMaxima = 160, color = beige, peso = 1200)
                                 ]

    trafic.cambiarInterior(popular)
    trafic.cambiarMotor(bataton)

    const rodadosParaCultura = [cachito, 
                                 new RenauldKwid(tieneTanque = true), 
                                 new RenauldKwid(tieneTanque = true),
                                 new RenauldKwid(tieneTanque = false),
                                 trafic
                                 ]                             

    deportes.agregarARodados(rodadosParaDeportes)
    cultura.agregarARodado(rodadosParaCultura)
  }

  //deportes
  test "Peso total de la flota de deportes es de " {
    assert.equals(1300 * 3 + 1350 + 1200, deportes.pesoTotal())
  }
}